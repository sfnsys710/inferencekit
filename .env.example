# Anthropic API Key (Required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Judge LLM model for evals
JUDGE_LLM=claude-sonnet-4-6

# LLM model used by the dashboard reason summarizer
EVAL_SUMMARIZER_LLM=claude-haiku-4-5-20251001

# Model Configuration
MODEL_ID=stepfun-ai/GOT-OCR-2.0-hf
# MODEL_CACHE_DIR=./models

# Device Settings (cpu, mps, or cuda)
# Note: GOT-OCR-2.0-hf has poor MPS performance on M2 - CPU is faster
DEVICE=cpu

# API Settings
API_HOST=0.0.0.0
API_PORT=8080

# Image Processing
# MAX_IMAGE_SIZE_MB=10
# SUPPORTED_FORMATS=jpg,jpeg,png,bmp,tiff

# Logging
# LOG_LEVEL=INFO
